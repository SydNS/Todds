{
  "expo": {
    "name": "Todds Learning App",
    "slug": "todds-learning-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tutoring.png",
    "scheme": "toddsapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash/rainbow-landscape.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#FFF0F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toddsapp.learning",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/tutoring.png",
        "backgroundColor": "#FFF0F5"
      },
      "package": "com.toddsapp.learning",
      "versionCode": 1,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/tutoring.png"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0026b2bd-1161-495b-b0d5-5eb7c832ca10"
      }
    }
  }
}
